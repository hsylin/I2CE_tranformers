#!/bin/sh
# Guest-side run script for experiment @ID@ (generated by exp.sh — do not edit).
# Delivered via gem5 --script at restore time; the boot checkpoint's rcS chain
# fetches it with `m5 readfile` and executes it.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
echo "[guest] ===== exp @ID@: cb=@CB@ learners=@NL@ sve=@SVE@ ====="
mkdir -p /mnt
mount -t 9p -o trans=virtio,version=9p2000.L,aname=@SHARE@ gem5 /mnt \
  || { echo "[guest] 9p mount FAILED"; /sbin/m5 fail 1; }
cd /mnt || /sbin/m5 fail 1
# The disk image may carry baked-in weights at /home/thu/TiC-SAT/weights, and
# transformer.o prefers that path when it exists. Shadow it with THIS
# experiment's weights so every run uses its own snapshot.
if [ -d /home/thu/TiC-SAT/weights ] && [ -d /mnt/weights/generated_from_notebook ]; then
  mount --bind /mnt/weights /home/thu/TiC-SAT/weights \
    && echo "[guest] weights: 9p snapshot shadows baked-in /home/thu/TiC-SAT/weights" \
    || { echo "[guest] weights bind mount FAILED"; /sbin/m5 fail 4; }
fi
sha256sum transformer.o
rm -f gem5_profile_regions.tsv
./transformer.o
RC=$?
echo "[guest] exp @ID@ exit code: $RC"
echo "[guest] ----- gem5_profile_regions.tsv -----"
cat gem5_profile_regions.tsv
/sbin/m5 writefile gem5_profile_regions.tsv gem5_profile_regions.tsv
if [ "$RC" -ne 0 ]; then /sbin/m5 fail "$RC"; fi
echo "[guest] done"
/sbin/m5 exit
